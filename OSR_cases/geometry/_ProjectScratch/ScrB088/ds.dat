outres,cont,all,
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (mm, t, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.

ERESX, NO

! ****** End   Command Snippet ******
! *********** WB SOLVE COMMAND ***********
! check interactive state
*get,ANSINTER_,active,,int
*if,ANSINTER_,ne,0,then
/eof
*endif
solve
/com *************** Write FE CONNECTORS ********* 
CEWRITE,file,ce,,INTE
/com,****************************************************
/com,*************** FINISHED SOLVE FOR LS 1 *************
fini
*get,_wallasol,active,,time,wall
/nopr
*get,_numnode,node,0,count
*get,_numelem,elem,0,count
*get, _MAXELEMNUM, elem, 0, NUM, MAX
*get, _MAXNODENUM, node, 0, NUM, MAX,,,INTERNAL
*get, _MAXELEMTYPE, etyp, 0, NUM, MAX
*get, _MAXREALCONST, rcon, 0, NUM, MAX
*get,_NSOLTHREADS,active,0,ntfs
*get,_NSOLPROCESSES,active,0,npfs
/gopr
*get,_PCGITER,active,,solu,cgiter
/post1
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed immediately after the ANSYS /POST1 command.

!   Active UNIT system in Workbench when this object was created:  Metric (mm, t, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.

/POST1
SET, LAST
/POST1
SET, LAST
RSYS, 0
AVRES, , NOAV

! Sélection PLANE183 uniquement
ESEL, S, ENAME, , 187
*GET, nb_elem, ELEM, , COUN

! Construction de la liste des IDs d'éléments (parcours fiable)
*DIM, EID_LIST, ARRAY, nb_elem
*GET, e_tmp, ELEM, , NUM, MIN
EID_LIST(1) = e_tmp
*DO, ie, 2, nb_elem
    *GET, e_tmp, ELEM, e_tmp, NXTH
    EID_LIST(ie) = e_tmp
*ENDDO

! Allocations : 4 nœuds-coins par élément
nb_pts=nb_elem*4 
*DIM, A_EID, ARRAY, nb_pts
*DIM, A_NID, ARRAY, nb_pts
*DIM, A_CX,  ARRAY, nb_pts
*DIM, A_CY,  ARRAY, nb_pts
*DIM, A_CZ,  ARRAY, nb_pts
*DIM, A_SX,  ARRAY, nb_pts
*DIM, A_SY,  ARRAY, nb_pts
*DIM, A_SZ,  ARRAY, nb_pts
*DIM, A_SXY, ARRAY, nb_pts
*DIM, A_SYZ, ARRAY, nb_pts
*DIM, A_SXZ, ARRAY, nb_pts

! Boucle : pour chaque élément, isoler puis extraire les 4 coins
*DO, ie, 1, nb_elem
    eid_cur = EID_LIST(ie)
    
    ! Isoler cet élément seul -> pas de moyennage possible
    ESEL, S, ELEM, , eid_cur
    
    *DO, k, 1, 4
        *GET, nid, ELEM, eid_cur, NODE, k
        idx = (ie-1)*4 + k
        
        A_EID(idx) = eid_cur
        A_NID(idx) = nid
        
        *GET, A_CX(idx), NODE, nid, LOC, X
        *GET, A_CY(idx), NODE, nid, LOC, Y
        *GET, A_CZ(idx), NODE, nid, LOC, Z
        
        *GET, A_SX(idx),  NODE, nid, S, X
        *GET, A_SY(idx),  NODE, nid, S, Y
        *GET, A_SZ(idx),  NODE, nid, S, Z
        *GET, A_SXY(idx), NODE, nid, S, XY
        *GET, A_SYZ(idx), NODE, nid, S, YZ
        *GET, A_SXZ(idx), NODE, nid, S, XZ
    *ENDDO
*ENDDO

! Re-sélection complète et écriture
ALLSEL, ALL

*CFOPEN,'C:\Users\samue\OSR\shared\sigma_export_nodes_horizontal', txt
*VLEN, nb_pts
*VWRITE, A_EID(1), A_NID(1), A_CX(1), A_CY(1), A_CZ(1), A_SX(1), A_SY(1), A_SZ(1), A_SXY(1), A_SYZ(1), A_SXZ(1)
(F8.0, F8.0, 3E14.6, 6E14.6)
*CFCLOS

!/SYS, C:\Users\lukas\OSR\OSR_model\run_pipeline.bat
! ****** End   Command Snippet ******
xmlo,ENCODING,ISO-8859-1
xmlo,parm
/xml,parm,xml
fini
/gopr
*get,_walldone,active,,time,wall
_preptime=(_wallbsol-_wallstrt)*3600
_solvtime=(_wallasol-_wallbsol)*3600
_posttime=(_walldone-_wallasol)*3600
_totaltim=(_walldone-_wallstrt)*3600
*get,_dlbratio,active,0,solu,dlbr
*get,_combtime,active,0,solu,comb
*get,_ssmode,active,0,solu,ssmm
*get,_ndofs,active,0,solu,ndof
*get,_sol_end_time,active,0,set,time
*if,_sol_end_time,eq,1.000000,then
/fclean				!clean distributed files
*endif
/com,--- Total number of nodes = %_numnode%
/com,--- Total number of elements = %_numelem%
/com,--- Element load balance ratio = %_dlbratio%
/com,--- Time to combine distributed files = %_combtime%
/com,--- Sparse memory mode = %_ssmode%
/com,--- Number of DOF = %_ndofs%
/wb,file,end               ! done with WB generated input
