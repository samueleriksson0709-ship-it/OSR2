# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 2")
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 3")
setupComponent1 = system2.GetComponent(Name="Setup")
system3 = GetSystem(Name="SYS 4")
setupComponent2 = system3.GetComponent(Name="Setup")
setupComponent1.DeleteTransfer(TargetComponent=setupComponent2)
geometry1 = system3.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
model1 = system3.GetContainer(ComponentName="Model")
model1.Edit()
model1.Exit()
modelComponent1 = system3.GetComponent(Name="Model")
modelComponent1.Refresh()
model1.Edit()
model1.Exit()
model1.Edit()
Save(Overwrite=True)
model1.Exit()
Save(Overwrite=True)
