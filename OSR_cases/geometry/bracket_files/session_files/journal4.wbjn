# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS")
system1.Copy(KeepConnections=False)
system2 = GetSystem(Name="SYS 2")
system2.DisplayText = "holed_plank"
geometry1 = system2.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system2.GetContainer(ComponentName="Model")
model1.Edit()
Update()
Update()
Update()
model1.Exit()
model1.Edit()
Update()
model1.Edit()
system3 = GetSystem(Name="SYS 1")
system3.Copy(KeepConnections=True)
system4 = GetSystem(Name="SYS 3")
setupComponent1 = system4.GetComponent(Name="Setup")
setupComponent2 = system2.GetComponent(Name="Setup")
setupComponent1.TransferData(TargetComponent=setupComponent2)
system4.DisplayText = "damage holed plank"
modelComponent1.Refresh()
setupComponent2.Refresh()
setup1 = system2.GetContainer(ComponentName="Setup")
setup1.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
model1.Exit()
Save(Overwrite=True)
