system8 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent4, modelComponent1],
    Position="Below",
    RelativeTo=system7)
system7.DisplayText = "bracket horizontal2"
system2.DisplayText = "bracket vertical"
system7.DisplayText = "bracket horizontal"
