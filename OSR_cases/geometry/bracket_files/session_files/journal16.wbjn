    ComponentsToShare=[engineeringDataComponent1, geometryComponent4, modelComponent1],
    Position="Below",
    RelativeTo=system6)
system6.DisplayText = "bracket 42deg"
system7.DisplayText = "bracket torsion"
setup4.Edit()
modelComponent3 = system6.GetComponent(Name="Model")
modelComponent3.Refresh()
setupComponent1 = system6.GetComponent(Name="Setup")
