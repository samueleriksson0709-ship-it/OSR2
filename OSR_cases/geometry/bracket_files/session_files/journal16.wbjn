geometryComponent1 = system4.GetComponent(Name="Geometry")
modelComponent2.TransferData(TargetComponent=geometryComponent1)
model3 = system4.GetContainer(ComponentName="Model")
model3.Edit()
model3.Exit()
modelComponent2.DeleteTransfer(TargetComponent=geometryComponent1)
