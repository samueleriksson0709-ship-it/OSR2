modelComponent1.DeleteTransfer(TargetComponent=geometryComponent3)
modelComponent1.DeleteTransfer(TargetComponent=geometryComponent3)
modelComponent1.DeleteTransfer(TargetComponent=geometryComponent1)
modelComponent1.DeleteTransfer(TargetComponent=geometryComponent2)
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
engineeringDataComponent1 = system2.GetComponent(Name="Engineering Data")
geometryComponent4 = system2.GetComponent(Name="Geometry")
system5 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent4, modelComponent1],
    Position="Below",
    RelativeTo=system1)
system1.Delete()
setup3 = system5.GetContainer(ComponentName="Setup")
setup3.Edit()
setup4 = system3.GetContainer(ComponentName="Setup")
setup4.Edit()
setup3.Edit()
Save(Overwrite=True)
system5.DisplayText = "bracket vertical"
setup3.Edit()
model2.Exit()
system6 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent4, modelComponent1],
    Position="Below",
    RelativeTo=system5)
