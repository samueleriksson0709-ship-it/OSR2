et,2,153
keyop,2,3,10        ! get plane stress option and thickness from underlying element
MAT,2 $ TYPE,2 $ REAL,2 $ SECNUM,2 $ ESYS,0    ! ELEMNODES = 3
eblock,21,COMPACT,,8
(21i9)
       65       63       60      111
       66       66       70      197
