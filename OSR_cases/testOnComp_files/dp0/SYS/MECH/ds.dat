*get,_NSOLTHREADS,active,0,ntfs
*get,_NSOLPROCESSES,active,0,npfs
/gopr
/post1
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed immediately after the ANSYS /POST1 command.

!   Active UNIT system in Workbench when this object was created:  Metric (m, kg, N, s, V, A)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


! ---------------------------------------------------------------------------
! OSR stress export block - paste this into a Commands (APDL) object placed
! under Solution in Mechanical.
!
! The export folder below MUST be the 'shared' folder of THIS machine's OSR
! checkout. APDL has no way of discovering it, so it is written out in full.
! Running  python configure_osr.py  from the OSR root rewrites both *CFOPEN
! lines with the correct local path.
! ---------------------------------------------------------------------------
/POST1
SET,LAST
RSYS,0
AVRES,,NO

! marker to signal to the pipeline that the APDl has run 
*CFOPEN,apdl_marker,txt,C:\Users\samue\OSR\shared
*VWRITE
('APDL Commands block executed')
*CFCLOS

ALLSEL,ALL
ESEL,S,ENAME,,183
*GET,nb_elem,ELEM,0,COUNT

*CFOPEN,sigma_export_nodes_tutorial,txt,C:\Users\samue\OSR\shared
*VWRITE
('# eid nid X Y Z SXX SYY SZZ SXY SYZ SXZ')
(A)

eid_cur = 0
*DO,ie,1,nb_elem
    ! advance to the next element in the 183 selection 
    *GET,eid_cur,ELEM,eid_cur,NXTH
    *IF,eid_cur,LE,0,EXIT

    ! isolate this element to read its own Gauss-to-node values
    ESEL,S,ELEM,,eid_cur

    *DO,k,1,4
        *GET,nid,ELEM,eid_cur,NODE,k
        *IF,nid,GT,0,THEN
            *GET,cx,NODE,nid,LOC,X
            *GET,cy,NODE,nid,LOC,Y
            *GET,cz,NODE,nid,LOC,Z
            *GET,sx, NODE,nid,S,X
            *GET,sy, NODE,nid,S,Y
            *GET,sz, NODE,nid,S,Z
            *GET,sxy,NODE,nid,S,XY
            *GET,syz,NODE,nid,S,YZ
            *GET,sxz,NODE,nid,S,XZ
            *VWRITE,eid_cur,nid,cx,cy,cz,sx,sy,sz,sxy,syz,sxz
            (F8.0,F8.0,3E14.6,6E14.6)
        *ENDIF
    *ENDDO

    ! restore the 183 selection so the next NXTH works properly 
    ESEL,S,ENAME,,183
*ENDDO
*CFCLOS
ALLSEL,ALL

! ****** End   Command Snippet ******
xmlo,ENCODING,ISO-8859-1
xmlo,parm
/xml,parm,xml
fini
/gopr
*get,_walldone,active,,time,wall
_preptime=(_wallbsol-_wallstrt)*3600
_solvtime=(_wallasol-_wallbsol)*3600
_posttime=(_walldone-_wallasol)*3600
_totaltim=(_walldone-_wallstrt)*3600
*get,_dlbratio,active,0,solu,dlbr
*get,_combtime,active,0,solu,comb
*get,_ssmode,active,0,solu,ssmm
*get,_ndofs,active,0,solu,ndof
*get,_sol_end_time,active,0,set,time
*if,_sol_end_time,eq,1.000000,then
/fclean				!clean distributed files
*endif
/com,--- Total number of nodes = %_numnode%
/com,--- Total number of elements = %_numelem%
/com,--- Element load balance ratio = %_dlbratio%
/com,--- Time to combine distributed files = %_combtime%
/com,--- Sparse memory mode = %_ssmode%
/com,--- Number of DOF = %_ndofs%
/wb,file,end               ! done with WB generated input
