!   Active UNIT system in Workbench when this object was created:  Metric (mm, t, N, s, mV, mA)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.

/POST1
SET, LAST
/POST1
SET, LAST
RSYS, 0
AVRES, , NOAV

! S_lection PLANE183 uniquement
ESEL, S, ENAME, , 187
*GET, nb_elem, ELEM, , COUN

! Construction de la liste des IDs d'_l_ments (parcours fiable)
*DIM, EID_LIST, ARRAY, nb_elem
*GET, e_tmp, ELEM, , NUM, MIN
EID_LIST(1) = e_tmp
*DO, ie, 2, nb_elem
    *GET, e_tmp, ELEM, e_tmp, NXTH
    EID_LIST(ie) = e_tmp
*ENDDO

! Allocations : 4 n_uds-coins par _l_ment
nb_pts=nb_elem*4 
*DIM, A_EID, ARRAY, nb_pts
*DIM, A_NID, ARRAY, nb_pts
*DIM, A_CX,  ARRAY, nb_pts
*DIM, A_CY,  ARRAY, nb_pts
*DIM, A_CZ,  ARRAY, nb_pts
*DIM, A_SX,  ARRAY, nb_pts
*DIM, A_SY,  ARRAY, nb_pts
*DIM, A_SZ,  ARRAY, nb_pts
*DIM, A_SXY, ARRAY, nb_pts
*DIM, A_SYZ, ARRAY, nb_pts
*DIM, A_SXZ, ARRAY, nb_pts

! Boucle : pour chaque _l_ment, isoler puis extraire les 4 coins
*DO, ie, 1, nb_elem
    eid_cur = EID_LIST(ie)
    
    ! Isoler cet _l_ment seul -&gt; pas de moyennage possible
    ESEL, S, ELEM, , eid_cur
    
    *DO, k, 1, 4
        *GET, nid, ELEM, eid_cur, NODE, k
        idx = (ie-1)*4 + k
        
        A_EID(idx) = eid_cur
        A_NID(idx) = nid
        
        *GET, A_CX(idx), NODE, nid, LOC, X
        *GET, A_CY(idx), NODE, nid, LOC, Y
        *GET, A_CZ(idx), NODE, nid, LOC, Z
        
        *GET, A_SX(idx),  NODE, nid, S, X
        *GET, A_SY(idx),  NODE, nid, S, Y
        *GET, A_SZ(idx),  NODE, nid, S, Z
        *GET, A_SXY(idx), NODE, nid, S, XY
        *GET, A_SYZ(idx), NODE, nid, S, YZ
        *GET, A_SXZ(idx), NODE, nid, S, XZ
    *ENDDO
*ENDDO

! Re-s_lection compl_te et _criture
ALLSEL, ALL

