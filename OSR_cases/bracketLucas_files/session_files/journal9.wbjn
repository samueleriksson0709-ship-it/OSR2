# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 4")
system1.Copy(KeepConnections=False)
system2 = GetSystem(Name="SYS 6")
geometry1 = system2.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system3 = GetSystem(Name="SYS")
system4 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system3)
geometry2 = system4.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="C:/Users/lukas/OSR/OSR_cases_ansys/bracket.stp")
geometry2.Edit(IsDiscoveryGeometry=True)
geometry2.Exit()
system2.Delete()
system5 = GetSystem(Name="SYS 5")
setup1 = system5.GetContainer(ComponentName="Setup")
externalLoadData1 = setup1.GetExternalLoadData()
externalLoadFileData1 = externalLoadData1.GetExternalLoadFileData(Name="ExternalLoadFileData")
externalLoadData1.DeleteFileData(FileData=externalLoadFileData1)
externalLoadFileData2 = setup1.AddDataFile(FilePath="C:/Users/lukas/OSR/OSR_model/damage.csv")
externalLoadFileDataProperty1 = externalLoadFileData2.GetDataProperty()
externalLoadFileData2.SetStartImportAtLine(
    FileDataProperty=externalLoadFileDataProperty1,
    LineNumber=2)
externalLoadFileDataProperty1.SetLengthUnit(Unit="mm")
externalLoadColumnData1 = externalLoadFileDataProperty1.GetColumnData(Name="ExternalLoadColumnData")
externalLoadFileDataProperty1.SetColumnDataType(
    ColumnData=externalLoadColumnData1,
    DataType="X Coordinate")
externalLoadColumnData2 = externalLoadFileDataProperty1.GetColumnData(Name="ExternalLoadColumnData 1")
externalLoadFileDataProperty1.SetColumnDataType(
    ColumnData=externalLoadColumnData2,
    DataType="Y Coordinate")
externalLoadColumnData3 = externalLoadFileDataProperty1.GetColumnData(Name="ExternalLoadColumnData 2")
externalLoadFileDataProperty1.SetColumnDataType(
    ColumnData=externalLoadColumnData3,
    DataType="Z Coordinate")
externalLoadColumnData4 = externalLoadFileDataProperty1.GetColumnData(Name="ExternalLoadColumnData 3")
externalLoadFileDataProperty1.SetColumnDataType(
    ColumnData=externalLoadColumnData4,
    DataType="Temperature")
externalLoadColumnData4.Identifier = "damage"
Update()
solution1 = system1.GetContainer(ComponentName="Solution")
solution1.Edit()
system4.DisplayText = "bracket"
system6 = GetSystem(Name="SYS 2")
system6.Copy(KeepConnections=True)
system7 = GetSystem(Name="SYS 6")
setup2 = system7.GetContainer(ComponentName="Setup")
setup2.Edit()
Save(Overwrite=True)
setup3 = system6.GetContainer(ComponentName="Setup")
setup3.Edit()
setup2.Edit()
externalLoadData1.DeleteFileData(FileData=externalLoadFileData2)
externalLoadFileData3 = setup1.AddDataFile(FilePath="C:/Users/lukas/OSR/OSR_model/damage.csv")
externalLoadFileDataProperty2 = externalLoadFileData3.GetDataProperty()
externalLoadFileData3.SetStartImportAtLine(
    FileDataProperty=externalLoadFileDataProperty2,
    LineNumber=2)
externalLoadFileDataProperty2.SetLengthUnit(Unit="mm")
externalLoadColumnData5 = externalLoadFileDataProperty2.GetColumnData(Name="ExternalLoadColumnData")
externalLoadFileDataProperty2.SetColumnDataType(
    ColumnData=externalLoadColumnData5,
    DataType="X Coordinate")
externalLoadColumnData6 = externalLoadFileDataProperty2.GetColumnData(Name="ExternalLoadColumnData 1")
externalLoadFileDataProperty2.SetColumnDataType(
    ColumnData=externalLoadColumnData6,
    DataType="Y Coordinate")
externalLoadColumnData7 = externalLoadFileDataProperty2.GetColumnData(Name="ExternalLoadColumnData 2")
externalLoadFileDataProperty2.SetColumnDataType(
    ColumnData=externalLoadColumnData7,
    DataType="Z Coordinate")
externalLoadColumnData8 = externalLoadFileDataProperty2.GetColumnData(Name="ExternalLoadColumnData 3")
externalLoadFileDataProperty2.SetColumnDataType(
    ColumnData=externalLoadColumnData8,
    DataType="Temperature")
externalLoadColumnData8.Identifier = "damage"
setup4 = system1.GetContainer(ComponentName="Setup")
setup4.Edit()
setupComponent1 = system1.GetComponent(Name="Setup")
setupComponent1.Update(AllDependencies=True)
solutionComponent1 = system1.GetComponent(Name="Solution")
solutionComponent1.Update(AllDependencies=True)
resultsComponent1 = system1.GetComponent(Name="Results")
resultsComponent1.Update(AllDependencies=True)
solution1.Edit()
model1 = system1.GetContainer(ComponentName="Model")
model1.Exit()
Save(Overwrite=True)
